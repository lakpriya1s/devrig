# devrig configuration
#
# Edit these values for your project, then run ./setup.sh
# This file is sourced by setup.sh and the git hooks — keep it valid shell
# (no spaces around `=`, arrays in parentheses).

PROJECT_NAME="acme"                # short lowercase name; names the generated .code-workspace file
GITHUB_ORG="AcmeInc"               # GitHub org (or username) that owns your repos
REPOS=(acme-api acme-web)          # repos setup.sh clones side-by-side; use REPOS=() for none
TICKET_PREFIX="AC"                 # issue-tracker ticket prefix, e.g. AC-123
DEFAULT_BRANCH="dev"               # protected default branch of your repos

# Feature toggles
ENABLE_SEMBLE=true                 # semantic code search, wired to agents via MCP
ENABLE_RTK=true                    # token-optimizing command proxy for Claude Code
ENABLE_LINEAR_MCP=true             # Linear issue tracking via MCP (used by /start-task, /create-ticket)
ENABLE_GIT_HOOKS=true              # block direct commits/pushes to protected branches
