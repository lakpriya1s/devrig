#!/bin/sh
# Blocks direct pushes to protected branches. Installed workspace-wide via
# core.hooksPath (see setup.sh). Bypass in a genuine emergency: git push --no-verify
# stdin: <local ref> <local sha> <remote ref> <remote sha> per ref being pushed
#
# The protected default branch comes from [project].default_branch in the
# workspace devrig.toml (read via python3's tomllib). main and master are
# always protected as well.
HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
DEFAULT_BRANCH="$(python3 - "$HOOKS_DIR/../devrig.toml" 2>/dev/null <<'PY'
import sys
try:
    import tomllib
except ModuleNotFoundError:
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        print("dev"); sys.exit()
try:
    with open(sys.argv[1], "rb") as f:
        print(tomllib.load(f).get("project", {}).get("default_branch", "dev"))
except Exception:
    print("dev")
PY
)"
[ -n "$DEFAULT_BRANCH" ] || DEFAULT_BRANCH=dev

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    "refs/heads/$DEFAULT_BRANCH"|refs/heads/main|refs/heads/master)
      branch="${remote_ref#refs/heads/}"
      echo "✗ Direct push to '$branch' is not allowed. Open a PR instead." >&2
      exit 1
      ;;
  esac
done
exit 0
