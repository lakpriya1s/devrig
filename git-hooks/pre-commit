#!/bin/sh
# Blocks direct commits on protected branches. Installed workspace-wide via
# core.hooksPath (see setup.sh). Bypass in a genuine emergency: git commit --no-verify
#
# The protected default branch comes from [project].default_branch in the
# workspace devrig.toml (read via python3's tomllib). main and master are
# always protected as well.
HOOKS_DIR="$(cd "$(dirname "$0")" && pwd)"
DEFAULT_BRANCH="$(python3 - "$HOOKS_DIR/../devrig.toml" 2>/dev/null <<'PY'
import sys
try:
    import tomllib
except ModuleNotFoundError:
    try:
        import tomli as tomllib
    except ModuleNotFoundError:
        print("dev"); sys.exit()
try:
    with open(sys.argv[1], "rb") as f:
        print(tomllib.load(f).get("project", {}).get("default_branch", "dev"))
except Exception:
    print("dev")
PY
)"
[ -n "$DEFAULT_BRANCH" ] || DEFAULT_BRANCH=dev

branch="$(git symbolic-ref --short HEAD 2>/dev/null)"
case "$branch" in
  "$DEFAULT_BRANCH"|main|master)
    echo "✗ Direct commits on '$branch' are not allowed." >&2
    echo "  Create a task branch first: git checkout -b <ticket-id>-<type>-<short-title>" >&2
    echo "  (or run /raise-pr in Claude Code — it moves your changes onto a task branch)" >&2
    exit 1
    ;;
esac
exit 0
